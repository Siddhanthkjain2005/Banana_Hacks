{
  "name": "rethread",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Image-driven circular design studio for fabric scraps: FabricNet, SlimSAM, grain-aware nesting, 3D assembly, Azure zero-waste lab",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs --api",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/api-demo.mjs",
    "sync:api": "node scripts/sync-api-core.mjs",
    "train:fabricnet": "node scripts/train-fabricnet.mjs --epochs 12 --per-epoch 9000",
    "sample:patterns": "node scripts/make-pattern-sample.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "engines": {
    "node": ">=20"
  }
}
